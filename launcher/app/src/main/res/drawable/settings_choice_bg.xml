<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EF2B25B" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FFF2B25B" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#24F2B25B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#BFF2B25B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181B1A2C" />
            <stroke android:width="1dp" android:color="#3DFBF4E8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
