<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="42dp"
        android:paddingBottom="54dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/smart_settings_title" android:textColor="#FFFFFFFF"
            android:textSize="34sp" android:fontFamily="@string/font_light" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="@string/smart_settings_summary" android:textColor="#AFFFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/minimalMode" style="@style/SettingsRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/minimal_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
        <TextView android:id="@+id/greetingName" style="@style/SettingsRow"
            android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/greeting_name_description" android:textColor="#FFACB8C1" android:textSize="14sp" />
        <TextView android:id="@+id/gregorianDate" style="@style/SettingsRow" />
        <TextView android:id="@+id/hijriCard" style="@style/SettingsRow" />
        <TextView android:id="@+id/contentCard" style="@style/SettingsRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/content_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
        <TextView android:id="@+id/prayerCard" style="@style/SettingsRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prayer_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
        <TextView android:id="@+id/footballCard" style="@style/SettingsRow" />
        <TextView android:id="@+id/hijriAdjust" style="@style/SettingsRow" />
        <TextView android:id="@+id/cityChoice" style="@style/SettingsRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/city_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
        <TextView android:id="@+id/teamChoice" style="@style/SettingsRow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/team_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
